# convert rabiit type number to name
execute if data entity @s {RabbitType:0} run data modify storage sap:tmp tmp.color set value "brown"
execute if data entity @s {RabbitType:1} run data modify storage sap:tmp tmp.color set value "white"
execute if data entity @s {RabbitType:2} run data modify storage sap:tmp tmp.color set value "black mottled"
execute if data entity @s {RabbitType:3} run data modify storage sap:tmp tmp.color set value "black and white spotted"
execute if data entity @s {RabbitType:4} run data modify storage sap:tmp tmp.color set value "cream"
execute if data entity @s {RabbitType:5} run data modify storage sap:tmp tmp.color set value "salt and pepper"

